# Knowledge Assistant configuration template.
# Copy to `.env` and fill in only the settings you intend to use.
# Required: KNOWLEDGE_ASSISTANT_DATABASE_URL (or POSTGRES_PASSWORD for Compose)
# and KNOWLEDGE_ASSISTANT_VAULT_PATH.
# Optional components are marked [optional] and can be left blank.

# --- Core (required) ---
KNOWLEDGE_ASSISTANT_ENVIRONMENT=development
# Local Obsidian vault directory (canonical Markdown source of truth).
KNOWLEDGE_ASSISTANT_VAULT_PATH=./var/vault
# PostgreSQL connection. Get it free locally from the docker-compose stack
# (Docker Desktop + the compose project) or any PostgreSQL 17 instance with the
# pgvector extension. No account or credential is needed to run locally.
KNOWLEDGE_ASSISTANT_DATABASE_URL=postgresql://knowledge_assistant:change-me-local@localhost:5432/knowledge_assistant
KNOWLEDGE_ASSISTANT_POSTGRES_PASSWORD=change-me-local
KNOWLEDGE_ASSISTANT_POSTGRES_PORT=5432

# --- Telegram bot [optional; required only for the bot service] ---
# Create a bot with @BotFather (free) and paste the token. The allowlist must be
# your numeric Telegram user id (see @userinfobot), not the bot username.
KNOWLEDGE_ASSISTANT_TELEGRAM_TOKEN=
KNOWLEDGE_ASSISTANT_TELEGRAM_ALLOWED_USER_IDS=
KNOWLEDGE_ASSISTANT_TELEGRAM_POLL_TIMEOUT_SECONDS=25

# --- Ingestion worker ---
KNOWLEDGE_ASSISTANT_WORKER_POLL_SECONDS=2

# --- Question Mode / demo / evaluation ---
KNOWLEDGE_ASSISTANT_SESSION_TTL_SECONDS=3600
# Production default retrieval strategy. Other values are explicit experiments.
KNOWLEDGE_ASSISTANT_RETRIEVAL_STRATEGY=weighted-hybrid-v1

# --- OpenAI credentials [required for embedding, generation, and evaluation] ---
# Sign up at platform.openai.com (pay-per-use; costs are a few cents for small
# demo/evaluation runs). The key is never printed or committed.
OPENAI_API_KEY=
# Model versions are intentionally explicit. text-embedding-3-small and a
# current generation model are the defaults used by the docs and benchmarks.
KNOWLEDGE_ASSISTANT_GENERATION_MODEL=
KNOWLEDGE_ASSISTANT_EMBEDDING_MODEL=
# [optional] reserved for a future model-based reranker; the deterministic
# diversity reranker does not use it.
KNOWLEDGE_ASSISTANT_RERANK_MODEL=

# --- X Articles [optional; only for saving X Article URLs] ---
# xquik_mpp (default) pays via a scoped Tempo wallet (authorize with the
# tempo-auth command; costs ~$0.00075 per article). `xquik` uses an API key.
KNOWLEDGE_ASSISTANT_X_ARTICLE_PROVIDER=xquik_mpp
KNOWLEDGE_ASSISTANT_XQUIK_API_KEY=
# Strict per-request cap for the xquik_mpp provider.
KNOWLEDGE_ASSISTANT_XQUIK_MPP_MAX_SPEND_USDC=0.001

# --- Monitoring [optional] ---
# Set the endpoint to http://lgtm:4318 and start the monitoring profile
# together with the application. Grafana is then available at
# http://localhost:3000 (admin/admin) with the curated Knowledge Assistant
# dashboard (7 panels) provisioned from config/grafana/.
KNOWLEDGE_ASSISTANT_OTEL_EXPORTER_OTLP_ENDPOINT=
KNOWLEDGE_ASSISTANT_GRAFANA_PORT=3000
KNOWLEDGE_ASSISTANT_OTLP_HTTP_PORT=4318

# --- Prefect orchestration [optional] ---
# Install the optional extra (`uv sync --extra orchestration`) and run
# `knowledge-assistant prefect-ingest --manifest data/sample/manifest.json` or
# the docker compose prefect-ingest service. No extra settings are required;
# the flow reuses DATABASE_URL and the allowlist above for notifications.

# --- Reserved for a future remote-vault adapter [optional] ---
# A local Obsidian vault needs only KNOWLEDGE_ASSISTANT_VAULT_PATH.
KNOWLEDGE_ASSISTANT_OBSIDIAN_API_URL=
KNOWLEDGE_ASSISTANT_OBSIDIAN_API_KEY=

# --- Reviewer demo ---
# `knowledge-assistant demo ask --question "..."` needs DATABASE_URL plus the
# OpenAI settings above and an active projection (ingest the sample corpus
# first with `demo ingest` / `sample-ingest`). It runs entirely without
# Telegram. Commands that call the API (ask, eval-run, eval-generate,
# answer-eval-run) incur small model costs; pure setup commands (migrate,
# sample-ingest, sample-eval-prepare, check-config) do not. No files under
# var/ are required for any of these commands.
