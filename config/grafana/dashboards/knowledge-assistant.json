{
  "uid": "knowledge-assistant-overview",
  "title": "Knowledge Assistant",
  "tags": ["knowledge-assistant"],
  "timezone": "browser",
  "editable": true,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Questions by outcome",
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (outcome) (rate(questions_total[5m]))",
          "legendFormat": "{{outcome}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Question latency (p95)",
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(question_stage_duration_seconds_bucket[5m])))",
          "legendFormat": "p95 seconds"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Retrieval candidates (mean)",
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(rate(retrieval_candidates_sum[5m])) / sum(rate(retrieval_candidates_count[5m]))",
          "legendFormat": "mean candidates"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Ingestion jobs by outcome",
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (outcome) (rate(ingestion_jobs_total[5m]))",
          "legendFormat": "{{outcome}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Ingestion duration (p95)",
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(ingestion_stage_duration_seconds_bucket[5m])))",
          "legendFormat": "p95 seconds"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Citation-validation outcomes",
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (outcome) (rate(citations_total[5m]))",
          "legendFormat": "{{outcome}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Answer feedback up/down",
      "gridPos": { "h": 7, "w": 24, "x": 0, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (direction) (rate(feedback_total[5m]))",
          "legendFormat": "{{direction}}"
        }
      ]
    }
  ]
}
